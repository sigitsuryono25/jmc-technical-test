{
  "name": "aplikasi-pengelolaan-barang",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aplikasi pengelolaan barang (barang masuk, master data, manajemen user) - Express + React + PostgreSQL",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"vite\"",
    "dev:api": "node --watch server/dev.js",
    "build": "vite build",
    "start": "node server/dev.js",
    "preview": "vite preview",
    "db:setup": "node scripts/db-setup.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
