# PostgreSQL (Supabase -> Project Settings -> Database -> Connection string / URI)
# Untuk Supabase gunakan Connection Pooling (port 6543) agar aman di serverless.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Set "disable" jika database lokal tanpa SSL
PGSSLMODE=require

# JWT
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=12h

# API (lokal)
PORT=3001
# Origin frontend yang diizinkan (opsional, pisahkan koma)
# CORS_ORIGIN=http://localhost:5173

# Supabase Storage untuk lampiran (wajib di production/Vercel)
# Buat bucket bernama "lampiran" dan set PUBLIC.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key
SUPABASE_BUCKET=lampiran
